<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Thème de toute l'app : Material 3 clair, couleurs QwizUp, police Figtree -->
    <style name="Base.Theme.QwizUp" parent="Theme.Material3.Light.NoActionBar">

        <!-- Couleur principale (boutons, champs actifs, cases cochées) -->
        <item name="colorPrimary">@color/primaire</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primaire_clair</item>
        <item name="colorOnPrimaryContainer">@color/primaire_fonce</item>

        <!-- Secondaire : la pastille de l'onglet actif dans la barre du bas -->
        <item name="colorSecondary">@color/primaire</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/primaire_clair</item>
        <item name="colorOnSecondaryContainer">@color/primaire_fonce</item>

        <!-- Tertiaire : accent soleil -->
        <item name="colorTertiary">@color/soleil_texte</item>
        <item name="colorTertiaryContainer">@color/soleil_clair</item>
        <item name="colorOnTertiaryContainer">@color/soleil_texte</item>

        <!-- Fonds et surfaces -->
        <item name="android:colorBackground">@color/fond</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/encre</item>
        <item name="colorOnSurfaceVariant">@color/encre_secondaire</item>

        <!-- Material 3 colore la barre du bas, les menus et les dialogues avec ces surfaces -->
        <item name="colorSurfaceContainerLowest">@color/white</item>
        <item name="colorSurfaceContainerLow">@color/white</item>
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>
        <item name="colorSurfaceContainerHighest">@color/fond</item>

        <!-- Bordures (champs, boutons à contour, cartes) -->
        <item name="colorOutline">@color/bordure</item>
        <item name="colorOutlineVariant">@color/bordure</item>

        <!-- Erreurs : corail foncé, lisible sur blanc -->
        <item name="colorError">@color/corail_texte</item>
        <item name="colorErrorContainer">@color/corail_clair</item>

        <!-- Police partout -->
        <item name="android:fontFamily">@font/figtree</item>
        <item name="fontFamily">@font/figtree</item>

        <!-- Barres du système : fond clair, icônes foncées -->
        <item name="android:statusBarColor">@color/fond</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.QwizUp" parent="Base.Theme.QwizUp" />
</resources>