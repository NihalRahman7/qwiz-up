        android:pathData="M24,28 a12,12 0 0,1 12,-12 h28 a12,12 0 0,1 12,12 v26 a12,12 0 0,1 -12,12 H48 l-14,13 V66 a12,12 0 0,1 -10,-12 z" />

    <!-- Le Q : un rond -->
