        android:pathData="M39,40 a11,11 0 1,0 22,0 a11,11 0 1,0 -22,0"
        android:strokeWidth="7"
        android:strokeColor="@color/primaire" />

    <!-- Le Q : sa queue -->
    <path
        android:pathData="M56,46 L62,52"
        android:strokeLineCap="round"
        android:strokeWidth="7"
        android:strokeColor="@color/primaire" />

