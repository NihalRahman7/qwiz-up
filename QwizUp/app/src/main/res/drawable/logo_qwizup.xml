    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Carré arrondi violet -->
    <path
        android:fillColor="@color/primaire"
        android:pathData="M24,0 h52 a24,24 0 0,1 24,24 v52 a24,24 0 0,1 -24,24 h-52 a24,24 0 0,1 -24,-24 v-52 a24,24 0 0,1 24,-24 z" />

    <!-- Bulle de dialogue blanche -->
    <path
