<?xml version="1.0" encoding="utf-8"?><!-- Écran Librairie : onglets Favoris / Complétés / Mes quiz et cartes de quiz -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    tools:context=".presentation.library.FragmentLibrairie">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- Onglets : bande violet pâle, l'onglet choisi est une pastille blanche qui se soulève -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bordure"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                app:checkedButton="@id/btnFavoris"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFavoris"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/figtree_extrabold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@animator/elevation_onglet"
                    android:text="@string/librairie_btn_favoris"
                    android:textColor="@color/texte_onglet"
                    android:textSize="14sp"
                    app:backgroundTint="@color/fond_onglet"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnComplets"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/figtree_extrabold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@animator/elevation_onglet"
                    android:text="@string/librairie_btn_completes"
                    android:textColor="@color/texte_onglet"
                    android:textSize="14sp"
                    app:backgroundTint="@color/fond_onglet"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCrees"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/figtree_extrabold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:stateListAnimator="@animator/elevation_onglet"
                    android:text="@string/librairie_btn_crees"
                    android:textColor="@color/texte_onglet"
                    android:textSize="14sp"
                    app:backgroundTint="@color/fond_onglet"
                    app:cornerRadius="12dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte 1 (remplie par le Fragment avec les données du modèle) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/carte1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Carré de la couleur de la catégorie (choisie par le Fragment) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/carre_categorie1"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardBackgroundColor="@color/primaire"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/icone_categorie1"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_play"
                            app:tint="@color/white" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/titre1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/figtree_extrabold"
                            android:textColor="@color/encre"
                            android:textSize="16sp"
                            tools:text="La Révolution tranquille" />

                        <TextView
                            android:id="@+id/soustitre1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/figtree_semibold"
                            android:textColor="@color/encre_secondaire"
                            android:textSize="13sp"
                            tools:text="4 questions · Public" />
                    </LinearLayout>

                    <!-- Badge : sa couleur dépend du type (choisie par le Fragment) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/badge1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:cardBackgroundColor="@color/menthe_clair"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/txtBadge1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/figtree_extrabold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/menthe_texte"
                            android:textSize="12sp"
                            tools:text="Publié" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <!-- Mes quiz seulement : ligne, code (ou « à la publication ») et Modifier -->
                <LinearLayout
                    android:id="@+id/ligne_cree1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/bordure" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_code1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawablePadding="6dp"
                            android:fontFamily="@font/figtree_extrabold"
                            android:gravity="center_vertical"
                            android:letterSpacing="0.08"
                            android:textColor="@color/primaire_fonce"
                            android:textSize="14sp"
                            tools:drawableStart="@drawable/ic_diese"
                            tools:text="K7M4Q" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_modifier1"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:fontFamily="@font/figtree_bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/librairie_modifier"
                            android:textColor="@color/encre"
                            android:textSize="14sp"
                            app:backgroundTint="@color/fond"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_modifier"
                            app:iconSize="16dp"
                            app:iconTint="@color/encre" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte 2 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/carte2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/carre_categorie2"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardBackgroundColor="@color/primaire"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/icone_categorie2"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_play"
                            app:tint="@color/white" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/titre2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/figtree_extrabold"
                            android:textColor="@color/encre"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/soustitre2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/figtree_semibold"
                            android:textColor="@color/encre_secondaire"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/badge2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:cardBackgroundColor="@color/menthe_clair"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/txtBadge2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/figtree_extrabold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/menthe_texte"
                            android:textSize="12sp" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ligne_cree2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/bordure" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_code2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawablePadding="6dp"
                            android:fontFamily="@font/figtree_extrabold"
                            android:gravity="center_vertical"
                            android:letterSpacing="0.08"
                            android:textColor="@color/primaire_fonce"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_modifier2"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:fontFamily="@font/figtree_bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/librairie_modifier"
                            android:textColor="@color/encre"
                            android:textSize="14sp"
                            app:backgroundTint="@color/fond"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_modifier"
                            app:iconSize="16dp"
                            app:iconTint="@color/encre" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte 3 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/carte3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/carre_categorie3"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardBackgroundColor="@color/primaire"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/icone_categorie3"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_play"
                            app:tint="@color/white" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/titre3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/figtree_extrabold"
                            android:textColor="@color/encre"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/soustitre3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/figtree_semibold"
                            android:textColor="@color/encre_secondaire"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/badge3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        app:cardBackgroundColor="@color/menthe_clair"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/txtBadge3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/figtree_extrabold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/menthe_texte"
                            android:textSize="12sp" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ligne_cree3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@color/bordure" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_code3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawablePadding="6dp"
                            android:fontFamily="@font/figtree_extrabold"
                            android:gravity="center_vertical"
                            android:letterSpacing="0.08"
                            android:textColor="@color/primaire_fonce"
                            android:textSize="14sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_modifier3"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:fontFamily="@font/figtree_bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/librairie_modifier"
                            android:textColor="@color/encre"
                            android:textSize="14sp"
                            app:backgroundTint="@color/fond"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_modifier"
                            app:iconSize="16dp"
                            app:iconTint="@color/encre" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Message affiché quand l'onglet n'a aucun quiz -->
        <TextView
            android:id="@+id/messageVide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="32dp"
            android:textColor="@color/encre_secondaire"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>