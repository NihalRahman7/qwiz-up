<?xml version="1.0" encoding="utf-8"?>
<!-- Éditeur de quiz : s'ouvre depuis Créer (« Nouveau quiz » ou « Continuer ») -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".presentation.create.EditeurQuizFragment">

    <!-- En-tête : fermer, titre de l'écran, nombre de questions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/button_fermer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_bouton_fermer"
            android:contentDescription="@string/editeur_fermer"
            android:src="@drawable/ic_fermer" />

        <TextView
            android:id="@+id/text_titre_ecran"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="21sp"
            android:textStyle="bold"
            tools:text="@string/editeur_titre_nouveau" />

        <TextView
            android:id="@+id/text_nombre_questions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            tools:text="1 question" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Image de couverture (automatique selon la catégorie) -->
            <LinearLayout
                android:id="@+id/zone_couverture"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_couverture"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/image_couverture"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_couverture_sciences" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/editeur_couverture_auto"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_prendre_photo"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="@string/editeur_prendre_photo"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary_green"
                        app:cornerRadius="26dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_galerie"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:layout_marginStart="8dp"
                        android:paddingStart="22dp"
                        android:paddingEnd="22dp"
                        android:text="@string/editeur_galerie"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_green"
                        app:cornerRadius="26dp"
                        app:strokeColor="@color/primary_green" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/editeur_label_titre"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/champ_titre"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/surface"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/primary_green"
                app:hintEnabled="false"
                app:placeholderText="@string/editeur_titre_placeholder">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/saisie_titre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/editeur_label_description"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/champ_description"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/surface"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/primary_green"
                app:hintEnabled="false"
                app:placeholderText="@string/editeur_description_placeholder">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/saisie_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/editeur_label_categorie"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/groupe_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:chipSpacingHorizontal="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_editeur_sciences"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texte_puce"
                    android:textSize="14sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/fond_puce"
                    app:chipMinHeight="44dp"
                    app:chipStrokeColor="@color/contour_puce"
                    app:chipStrokeWidth="1dp"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
                    android:text="@string/category_sciences" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_editeur_histoire"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texte_puce"
                    android:textSize="14sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/fond_puce"
                    app:chipMinHeight="44dp"
                    app:chipStrokeColor="@color/contour_puce"
                    app:chipStrokeWidth="1dp"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
                    android:text="@string/category_history" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_editeur_langues"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texte_puce"
                    android:textSize="14sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/fond_puce"
                    app:chipMinHeight="44dp"
                    app:chipStrokeColor="@color/contour_puce"
                    app:chipStrokeWidth="1dp"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
                    android:text="@string/category_languages" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_editeur_informatique"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texte_puce"
                    android:textSize="14sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/fond_puce"
                    app:chipMinHeight="44dp"
                    app:chipStrokeColor="@color/contour_puce"
                    app:chipStrokeWidth="1dp"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
                    android:text="@string/category_informatique" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_editeur_geographie"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texte_puce"
                    android:textSize="14sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/fond_puce"
                    app:chipMinHeight="44dp"
                    app:chipStrokeColor="@color/contour_puce"
                    app:chipStrokeWidth="1dp"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
                    android:text="@string/category_geography" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_editeur_autre"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/texte_puce"
                    android:textSize="14sp"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="@color/fond_puce"
                    app:chipMinHeight="44dp"
                    app:chipStrokeColor="@color/contour_puce"
                    app:chipStrokeWidth="1dp"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
                    android:text="@string/category_autre" />

            </com.google.android.material.chip.ChipGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/editeur_label_difficulte"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/border"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/groupe_difficulte"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_facile"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/editeur_facile"
                        android:stateListAnimator="@animator/elevation_onglet"
                        android:textColor="@color/texte_onglet"
                        android:textStyle="bold"
                        app:backgroundTint="@color/fond_onglet"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_moyen"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/editeur_moyen"
                        android:stateListAnimator="@animator/elevation_onglet"
                        android:textColor="@color/texte_onglet"
                        android:textStyle="bold"
                        app:backgroundTint="@color/fond_onglet"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_difficile"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/editeur_difficile"
                        android:stateListAnimator="@animator/elevation_onglet"
                        android:textColor="@color/texte_onglet"
                        android:textStyle="bold"
                        app:backgroundTint="@color/fond_onglet"
                        app:cornerRadius="12dp" />

                </com.google.android.material.button.MaterialButtonToggleGroup>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/editeur_label_acces"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="@color/border"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/groupe_acces"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_acces_tous"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/editeur_acces_tous"
                        android:stateListAnimator="@animator/elevation_onglet"
                        android:textColor="@color/texte_onglet"
                        android:textStyle="bold"
                        app:backgroundTint="@color/fond_onglet"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_acces_code"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/editeur_acces_code"
                        android:stateListAnimator="@animator/elevation_onglet"
                        android:textColor="@color/texte_onglet"
                        android:textStyle="bold"
                        app:backgroundTint="@color/fond_onglet"
                        app:cornerRadius="12dp" />

                </com.google.android.material.button.MaterialButtonToggleGroup>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/text_aide_acces"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="@string/editeur_acces_code_aide" />

            <!-- Les questions (remplies par le présentateur) -->
            <LinearLayout
                android:id="@+id/liste_questions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_ajouter_question"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/editeur_ajouter_question"
                android:textColor="@color/primary_green"
                android:textSize="16sp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconTint="@color/primary_green"
                app:strokeColor="@color/primary_green"
                app:strokeWidth="2dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Boutons du bas -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border" />

    <LinearLayout
        android:id="@+id/barre_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_brouillon"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/editeur_brouillon"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            app:cornerRadius="16dp"
            app:strokeColor="@color/border" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_publier"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/editeur_publier"
            android:textSize="16sp"
            app:backgroundTint="@color/primary_green"
            app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>