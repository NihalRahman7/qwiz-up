<?xml version="1.0" encoding="utf-8"?><!-- Éditeur de quiz en 4 étapes : Infos, Questions, Options, Publier -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:orientation="vertical"
    tools:context=".presentation.create.ÉditeurQuizFragment">

    <!-- En-tête : ✕, « Nouveau quiz · Étape 1 sur 4 » et le titre de l'étape -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp">

        <ImageButton
            android:id="@+id/button_fermer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_bouton_fermer"
            android:contentDescription="@string/editeur_fermer"
            android:src="@drawable/ic_fermer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_etape"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_bold"
                android:textColor="@color/encre_secondaire"
                android:textSize="14sp"
                tools:text="Nouveau quiz · Étape 1 sur 4" />

            <TextView
                android:id="@+id/text_titre_etape"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_extrabold"
                android:textColor="@color/encre"
                android:textSize="24sp"
                tools:text="Les bases" />
        </LinearLayout>

        <!-- Remplis par le présentateur ; cachés, mais lus pour l'en-tête et le résumé -->
        <TextView
            android:id="@+id/text_titre_ecran"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_nombre_questions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Les 4 barres d'étapes avec leur nom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:id="@+id/barre_etape_1"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:background="@drawable/bg_pastille"
                android:backgroundTint="@color/primaire" />

            <TextView
                android:id="@+id/libelle_etape_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/figtree_extrabold"
                android:text="@string/creer_onglet_infos"
                android:textColor="@color/primaire"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:id="@+id/barre_etape_2"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:background="@drawable/bg_pastille"
                android:backgroundTint="@color/bordure" />

            <TextView
                android:id="@+id/libelle_etape_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/figtree_semibold"
                android:text="@string/creer_onglet_questions"
                android:textColor="@color/encre_secondaire"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:id="@+id/barre_etape_3"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:background="@drawable/bg_pastille"
                android:backgroundTint="@color/bordure" />

            <TextView
                android:id="@+id/libelle_etape_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/figtree_semibold"
                android:text="@string/creer_onglet_options"
                android:textColor="@color/encre_secondaire"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:id="@+id/barre_etape_4"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:background="@drawable/bg_pastille"
                android:backgroundTint="@color/bordure" />

            <TextView
                android:id="@+id/libelle_etape_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/figtree_semibold"
                android:text="@string/creer_onglet_publier"
                android:textColor="@color/encre_secondaire"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/defilement_editeur"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ===== Étape 1 : les bases ===== -->
            <LinearLayout
                android:id="@+id/etape_infos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Image de couverture : remplie par le présentateur, pas montrée dans le canevas -->
                <LinearLayout
                    android:id="@+id/zone_couverture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_couverture"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/image_couverture"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_couverture_sciences" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/figtree_extrabold"
                    android:text="@string/editeur_label_titre"
                    android:textColor="@color/encre"
                    android:textSize="15sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/champ_titre"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="@color/white"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxStrokeColor="@color/primaire"
                    app:hintEnabled="false"
                    app:placeholderText="@string/editeur_titre_placeholder">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/saisie_titre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="1"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:textColor="@color/encre"
                        android:textSize="17sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/figtree_extrabold"
                    android:text="@string/editeur_label_categorie"
                    android:textColor="@color/encre"
                    android:textSize="15sp" />

                <!-- Puces de catégorie : leurs couleurs et icônes sont mises par le Fragment -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/groupe_categories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacingHorizontal="10dp"
                    app:chipSpacingVertical="10dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_editeur_sciences"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_extrabold"
                        android:text="@string/category_sciences"
                        android:textSize="15sp"
                        app:chipCornerRadius="16dp"
                        app:chipIconSize="20dp"
                        app:chipMinHeight="48dp"
                        app:chipStrokeWidth="0dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_editeur_histoire"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_extrabold"
                        android:text="@string/category_history"
                        android:textSize="15sp"
                        app:chipCornerRadius="16dp"
                        app:chipIconSize="20dp"
                        app:chipMinHeight="48dp"
                        app:chipStrokeWidth="0dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_editeur_langues"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_extrabold"
                        android:text="@string/category_languages"
                        android:textSize="15sp"
                        app:chipCornerRadius="16dp"
                        app:chipIconSize="20dp"
                        app:chipMinHeight="48dp"
                        app:chipStrokeWidth="0dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_editeur_geographie"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_extrabold"
                        android:text="@string/category_geography"
                        android:textSize="15sp"
                        app:chipCornerRadius="16dp"
                        app:chipIconSize="20dp"
                        app:chipMinHeight="48dp"
                        app:chipStrokeWidth="0dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_editeur_informatique"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_extrabold"
                        android:text="@string/category_informatique"
                        android:textSize="15sp"
                        app:chipCornerRadius="16dp"
                        app:chipIconSize="20dp"
                        app:chipMinHeight="48dp"
                        app:chipStrokeWidth="0dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_editeur_autre"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_extrabold"
                        android:text="@string/category_autre"
                        android:textSize="15sp"
                        app:chipCornerRadius="16dp"
                        app:chipIconSize="20dp"
                        app:chipMinHeight="48dp"
                        app:chipStrokeWidth="0dp" />
                </com.google.android.material.chip.ChipGroup>

                <!-- Visible seulement quand la catégorie « Autre » est choisie -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/champ_categorie_perso"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:visibility="gone"
                    app:boxBackgroundColor="@color/white"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxStrokeColor="@color/primaire"
                    app:helperText="@string/editeur_label_categorie_perso"
                    app:hintEnabled="false"
                    app:placeholderText="@string/editeur_categorie_perso_placeholder">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/saisie_categorie_perso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/figtree_semibold"
                    android:text="@string/creer_aide_autre"
                    android:textColor="@color/encre_secondaire"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/figtree_extrabold"
                    android:text="@string/editeur_label_description"
                    android:textColor="@color/encre"
                    android:textSize="15sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/champ_description"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:boxBackgroundColor="@color/white"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxStrokeColor="@color/primaire"
                    app:hintEnabled="false"
                    app:placeholderText="@string/editeur_description_placeholder">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/saisie_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:minLines="3"
                        android:textColor="@color/encre"
                        android:textSize="17sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- ===== Étape 2 : les questions ===== -->
            <LinearLayout
                android:id="@+id/etape_questions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Les questions (remplies par le présentateur) -->
                <LinearLayout
                    android:id="@+id/liste_questions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_ajouter_question"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/figtree_extrabold"
                    android:text="@string/editeur_ajouter_question"
                    android:textColor="@color/primaire"
                    android:textSize="16sp"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconTint="@color/primaire"
                    app:strokeColor="@color/primaire"
                    app:strokeWidth="2dp" />
            </LinearLayout>

            <!-- ===== Étape 3 : les options ===== -->
            <LinearLayout
                android:id="@+id/etape_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/figtree_extrabold"
                    android:text="@string/editeur_label_difficulte"
                    android:textColor="@color/encre"
                    android:textSize="15sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/bordure"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/groupe_difficulte"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_facile"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/figtree_extrabold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:stateListAnimator="@animator/elevation_onglet"
                            android:text="@string/editeur_facile"
                            android:textColor="@color/texte_onglet"
                            app:backgroundTint="@color/fond_onglet"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_moyen"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/figtree_extrabold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:stateListAnimator="@animator/elevation_onglet"
                            android:text="@string/editeur_moyen"
                            android:textColor="@color/texte_onglet"
                            app:backgroundTint="@color/fond_onglet"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_difficile"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/figtree_extrabold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:stateListAnimator="@animator/elevation_onglet"
                            android:text="@string/editeur_difficile"
                            android:textColor="@color/texte_onglet"
                            app:backgroundTint="@color/fond_onglet"
                            app:cornerRadius="12dp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/figtree_extrabold"
                    android:text="@string/editeur_label_acces"
                    android:textColor="@color/encre"
                    android:textSize="15sp" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/bordure"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/groupe_acces"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="4dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_acces_tous"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/figtree_extrabold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:stateListAnimator="@animator/elevation_onglet"
                            android:text="@string/editeur_acces_tous"
                            android:textColor="@color/texte_onglet"
                            app:backgroundTint="@color/fond_onglet"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_acces_code"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/figtree_extrabold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:stateListAnimator="@animator/elevation_onglet"
                            android:text="@string/editeur_acces_code"
                            android:textColor="@color/texte_onglet"
                            app:backgroundTint="@color/fond_onglet"
                            app:cornerRadius="12dp" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/text_aide_acces"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/encre_secondaire"
                    android:textSize="13sp"
                    tools:text="@string/editeur_acces_code_aide" />

                <!-- Explication du code de 5 caractères -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_carre"
                    android:backgroundTint="@color/primaire_clair"
                    android:drawablePadding="10dp"
                    android:fontFamily="@font/figtree_semibold"
                    android:gravity="center_vertical"
                    android:lineSpacingExtra="2sp"
                    android:padding="14dp"
                    android:text="@string/editeur_code_aide"
                    android:textColor="@color/primaire_fonce"
                    android:textSize="13sp"
                    app:drawableStartCompat="@drawable/ic_diese" />
            </LinearLayout>

            <!-- ===== Étape 4 : vérifie et publie ===== -->
            <LinearLayout
                android:id="@+id/etape_publier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Résumé du quiz (rempli par le Fragment avec les champs des étapes 1 à 3) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/text_resume_titre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/figtree_extrabold"
                            android:textColor="@color/encre"
                            android:textSize="20sp"
                            tools:text="La Révolution tranquille" />

                        <TextView
                            android:id="@+id/text_resume_details"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/figtree_semibold"
                            android:textColor="@color/encre_secondaire"
                            android:textSize="14sp"
                            tools:text="Histoire · Moyen · Public" />

                        <TextView
                            android:id="@+id/text_resume_questions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_pastille"
                            android:backgroundTint="@color/primaire_clair"
                            android:fontFamily="@font/figtree_extrabold"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp"
                            android:textColor="@color/primaire_fonce"
                            android:textSize="13sp"
                            tools:text="4 questions" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bas de l'écran -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bordure" />

    <LinearLayout
        android:id="@+id/barre_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fond"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- Étape 4 seulement : publier ou garder en brouillon, puis enregistrer -->
        <LinearLayout
            android:id="@+id/zone_publier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Case à cocher : publier le quiz ou le garder en brouillon -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/case_publier"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/figtree_bold"
                android:text="@string/editeur_case_publier"
                android:textColor="@color/encre"
                android:textSize="16sp"
                app:buttonTint="@color/primaire" />

            <!-- Un seul bouton : « Enregistrer le brouillon » ou « Publier » selon la case -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_enregistrer"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:fontFamily="@font/figtree_extrabold"
                android:text="@string/editeur_enregistrer_brouillon"
                android:textColor="@color/texte_bouton_principal"
                android:textSize="16sp"
                app:backgroundTint="@color/fond_bouton_principal"
                app:cornerRadius="16dp" />

            <!-- Explique pourquoi le bouton est gris -->
            <TextView
                android:id="@+id/text_raison_bouton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/encre_secondaire"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ← Retour / Suivant → : passent d'une étape à l'autre -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_etape_precedente"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/figtree_extrabold"
                android:text="@string/creer_retour"
                android:textColor="@color/encre"
                android:textSize="16sp"
                app:backgroundTint="@color/white"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_retour"
                app:iconGravity="textStart"
                app:iconTint="@color/encre"
                app:strokeColor="@color/bordure" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_etape_suivante"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:fontFamily="@font/figtree_extrabold"
                android:text="@string/creer_suivant"
                android:textSize="16sp"
                app:backgroundTint="@color/primaire"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_fleche_droite"
                app:iconGravity="textEnd"
                app:iconTint="@color/white" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>