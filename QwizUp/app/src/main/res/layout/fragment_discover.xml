<?xml version="1.0" encoding="utf-8"?><!-- Écran Découvrir : barre de recherche, catégories et grille de cartes de quiz -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.discover.VueDécouvrir">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <!-- Barre de recherche -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="20dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/bordure"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/edit_search"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/discover_search_hint"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/encre"
                    android:textColorHint="@color/encre_secondaire"
                    android:textSize="16sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Catégories : elles passent à la ligne quand il n'y a plus de place -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="20dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:singleLine="false">

            <!-- Catégorie choisie : fond foncé -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_bold"
                android:text="@string/category_all"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:chipBackgroundColor="@color/encre"
                app:chipMinHeight="40dp"
                app:chipStrokeColor="@color/encre"
                app:chipStrokeWidth="1.5dp"
                app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />


            <!-- Autres catégories : fond blanc -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sciences"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_bold"
                android:text="@string/category_sciences"
                android:textColor="@color/encre"
                android:textSize="14sp"
                app:chipBackgroundColor="@color/white"
                app:chipMinHeight="40dp"
                app:chipStrokeColor="@color/bordure"
                app:chipStrokeWidth="1.5dp"
                app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_history"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_bold"
                android:text="@string/category_history"
                android:textColor="@color/encre"
                android:textSize="14sp"
                app:chipBackgroundColor="@color/white"
                app:chipMinHeight="40dp"
                app:chipStrokeColor="@color/bordure"
                app:chipStrokeWidth="1.5dp"
                app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_languages"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_bold"
                android:text="@string/category_languages"
                android:textColor="@color/encre"
                android:textSize="14sp"
                app:chipBackgroundColor="@color/white"
                app:chipMinHeight="40dp"
                app:chipStrokeColor="@color/bordure"
                app:chipStrokeWidth="1.5dp"
                app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_geography"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_bold"
                android:text="@string/category_geography"
                android:textColor="@color/encre"
                android:textSize="14sp"
                app:chipBackgroundColor="@color/white"
                app:chipMinHeight="40dp"
                app:chipStrokeColor="@color/bordure"
                app:chipStrokeWidth="1.5dp"
                app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_informatique"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_bold"
                android:text="@string/category_informatique"
                android:textColor="@color/encre"
                android:textSize="14sp"
                app:chipBackgroundColor="@color/white"
                app:chipMinHeight="40dp"
                app:chipStrokeColor="@color/bordure"
                app:chipStrokeWidth="1.5dp"
                app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_autre"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/figtree_bold"
                android:text="@string/category_autre"
                android:textColor="@color/encre"
                android:textSize="14sp"
                app:chipBackgroundColor="@color/white"
                app:chipMinHeight="40dp"
                app:chipStrokeColor="@color/bordure"
                app:chipStrokeWidth="1.5dp"
                app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Cartes de quiz : grille de 2 colonnes. Toucher une carte ouvre le jeu. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- Indicateur affiché pendant que les quiz se chargent -->
            <ProgressBar
                android:id="@+id/indicateurChargement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_margin="24dp"
                android:indeterminateTint="@color/primaire"
                android:visibility="gone" />

            <!-- Rangée 1 : cartes 1 et 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Carte n° 1 (remplie par le Fragment avec les données du modèle) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/carte1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="12dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Couverture : couleur et icône de la catégorie (choisies par le Fragment) -->
                        <FrameLayout
                            android:id="@+id/couverture1"
                            android:layout_width="match_parent"
                            android:layout_height="92dp"
                            android:background="@color/categorie_autre">

                            <ImageView
                                android:id="@+id/icone1"
                                android:layout_width="110dp"
                                android:layout_height="110dp"
                                android:layout_gravity="bottom|end"
                                android:layout_marginEnd="-22dp"
                                android:layout_marginBottom="-30dp"
                                android:alpha="0.25"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_couverture_autre"
                                app:tint="@color/white" />

                            <TextView
                                android:id="@+id/categorie1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|start"
                                android:layout_margin="12dp"
                                android:background="@drawable/bg_pastille"
                                android:backgroundTint="@color/voile_sombre"
                                android:fontFamily="@font/figtree_extrabold"
                                android:paddingStart="8dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="4dp"
                                android:textColor="@color/white"
                                android:textSize="11sp"
                                tools:text="@string/category_geography" />

                            <ImageButton
                                android:id="@+id/favori1"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="top|end"
                                android:layout_margin="4dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/discover_add_favorite"
                                android:scaleType="center"
                                android:src="@drawable/ic_star_outline"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="14dp">

                            <TextView
                                android:id="@+id/titre1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/figtree_extrabold"
                                android:maxLines="2"
                                android:minLines="2"
                                android:textColor="@color/encre"
                                android:textSize="15sp"
                                tools:text="Capitales d’Europe" />

                            <!-- La description n'est pas montrée dans la grille (gardée pour le Fragment) -->
                            <TextView
                                android:id="@+id/description1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/details1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/figtree_semibold"
                                android:textColor="@color/encre_secondaire"
                                android:textSize="12sp"
                                tools:text="4 questions · 2 min" />

                            <!-- Meilleur score, ou « Pas encore joué » -->
                            <TextView
                                android:id="@+id/score1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/figtree_extrabold"
                                android:textSize="12sp"
                                tools:text="Meilleur 80 %" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Carte n° 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/carte2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/couverture2"
                            android:layout_width="match_parent"
                            android:layout_height="92dp"
                            android:background="@color/categorie_autre">

                            <ImageView
                                android:id="@+id/icone2"
                                android:layout_width="110dp"
                                android:layout_height="110dp"
                                android:layout_gravity="bottom|end"
                                android:layout_marginEnd="-22dp"
                                android:layout_marginBottom="-30dp"
                                android:alpha="0.25"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_couverture_autre"
                                app:tint="@color/white" />

                            <TextView
                                android:id="@+id/categorie2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|start"
                                android:layout_margin="12dp"
                                android:background="@drawable/bg_pastille"
                                android:backgroundTint="@color/voile_sombre"
                                android:fontFamily="@font/figtree_extrabold"
                                android:paddingStart="8dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="4dp"
                                android:textColor="@color/white"
                                android:textSize="11sp" />

                            <ImageButton
                                android:id="@+id/favori2"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="top|end"
                                android:layout_margin="4dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/discover_add_favorite"
                                android:scaleType="center"
                                android:src="@drawable/ic_star_outline"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="14dp">

                            <TextView
                                android:id="@+id/titre2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/figtree_extrabold"
                                android:maxLines="2"
                                android:minLines="2"
                                android:textColor="@color/encre"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/description2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/details2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/figtree_semibold"
                                android:textColor="@color/encre_secondaire"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/score2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/figtree_extrabold"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Rangée 2 : cartes 3 et 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Carte n° 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/carte3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="12dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/couverture3"
                            android:layout_width="match_parent"
                            android:layout_height="92dp"
                            android:background="@color/categorie_autre">

                            <ImageView
                                android:id="@+id/icone3"
                                android:layout_width="110dp"
                                android:layout_height="110dp"
                                android:layout_gravity="bottom|end"
                                android:layout_marginEnd="-22dp"
                                android:layout_marginBottom="-30dp"
                                android:alpha="0.25"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_couverture_autre"
                                app:tint="@color/white" />

                            <TextView
                                android:id="@+id/categorie3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|start"
                                android:layout_margin="12dp"
                                android:background="@drawable/bg_pastille"
                                android:backgroundTint="@color/voile_sombre"
                                android:fontFamily="@font/figtree_extrabold"
                                android:paddingStart="8dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="4dp"
                                android:textColor="@color/white"
                                android:textSize="11sp" />

                            <ImageButton
                                android:id="@+id/favori3"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="top|end"
                                android:layout_margin="4dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/discover_add_favorite"
                                android:scaleType="center"
                                android:src="@drawable/ic_star_outline"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="14dp">

                            <TextView
                                android:id="@+id/titre3"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/figtree_extrabold"
                                android:maxLines="2"
                                android:minLines="2"
                                android:textColor="@color/encre"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/description3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/details3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/figtree_semibold"
                                android:textColor="@color/encre_secondaire"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/score3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/figtree_extrabold"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Carte n° 4 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/carte4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/couverture4"
                            android:layout_width="match_parent"
                            android:layout_height="92dp"
                            android:background="@color/categorie_autre">

                            <ImageView
                                android:id="@+id/icone4"
                                android:layout_width="110dp"
                                android:layout_height="110dp"
                                android:layout_gravity="bottom|end"
                                android:layout_marginEnd="-22dp"
                                android:layout_marginBottom="-30dp"
                                android:alpha="0.25"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_couverture_autre"
                                app:tint="@color/white" />

                            <TextView
                                android:id="@+id/categorie4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|start"
                                android:layout_margin="12dp"
                                android:background="@drawable/bg_pastille"
                                android:backgroundTint="@color/voile_sombre"
                                android:fontFamily="@font/figtree_extrabold"
                                android:paddingStart="8dp"
                                android:paddingTop="4dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="4dp"
                                android:textColor="@color/white"
                                android:textSize="11sp" />

                            <ImageButton
                                android:id="@+id/favori4"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="top|end"
                                android:layout_margin="4dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/discover_add_favorite"
                                android:scaleType="center"
                                android:src="@drawable/ic_star_outline"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="14dp">

                            <TextView
                                android:id="@+id/titre4"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/figtree_extrabold"
                                android:maxLines="2"
                                android:minLines="2"
                                android:textColor="@color/encre"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/description4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/details4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/figtree_semibold"
                                android:textColor="@color/encre_secondaire"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/score4"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/figtree_extrabold"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Message affiché quand aucun quiz ne correspond à la recherche -->
            <TextView
                android:id="@+id/messageVide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/discover_no_quiz"
                android:textColor="@color/encre_secondaire"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>