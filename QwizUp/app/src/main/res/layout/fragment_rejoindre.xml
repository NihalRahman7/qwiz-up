<?xml version="1.0" encoding="utf-8"?>
<!-- Écran Rejoindre : entrer un code à 6 chiffres pour rejoindre un quiz -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".presentation.rejoindre.RejoindreFragment">

    <!-- Bouton retour -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_retour"
        style="@style/Widget.Material3.Button.IconButton.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/rejoindre_retour"
        app:icon="@drawable/ic_fermer"
        app:iconTint="@color/text_primary"
        app:strokeColor="@color/border" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/rejoindre_titre"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/rejoindre_sous_titre"
        android:textColor="@color/text_secondary"
        android:textSize="15sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/rejoindre_label_code"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Champ du code : 6 chiffres, affichés en grand -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/champ_code"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:boxBackgroundColor="@color/surface"
        app:boxCornerRadiusBottomEnd="18dp"
        app:boxCornerRadiusBottomStart="18dp"
        app:boxCornerRadiusTopEnd="18dp"
        app:boxCornerRadiusTopStart="18dp"
        app:boxStrokeColor="@color/primary_green"
        app:hintEnabled="false">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:hint="000000"
            android:imeOptions="actionGo"
            android:inputType="number"
            android:letterSpacing="0.4"
            android:maxLength="6"
            android:paddingVertical="18dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/border"
            android:textSize="30sp"
            android:textStyle="bold" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Bouton Rejoindre : actif seulement avec 6 chiffres -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_rejoindre"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:enabled="false"
        android:text="@string/rejoindre_bouton"
        android:textColor="@color/texte_bouton_principal"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/fond_bouton_principal"
        app:cornerRadius="16dp" />

</LinearLayout>