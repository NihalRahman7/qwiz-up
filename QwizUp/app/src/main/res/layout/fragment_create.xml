<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.create.CreateFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Bouton Nouveau quiz -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_nouveau_quiz"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/creer_nouveau_quiz"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/text_primary"
            app:cornerRadius="18dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textEnd"
            app:iconSize="24dp" />

        <!-- Onglets Brouillons / Publiés (même style que la Librairie) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/light_green"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/groupe_onglets_creer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                app:checkedButton="@id/button_onglet_brouillons"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_onglet_brouillons"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/creer_onglet_brouillons_defaut"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    app:cornerRadius="20dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_onglet_publies"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/creer_onglet_publies_defaut"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    app:cornerRadius="20dp" />

            </com.google.android.material.button.MaterialButtonToggleGroup>
        </com.google.android.material.card.MaterialCardView>

        <!-- Liste des quiz de l'onglet choisi (remplie par le présentateur) -->
        <LinearLayout
            android:id="@+id/liste_quiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
