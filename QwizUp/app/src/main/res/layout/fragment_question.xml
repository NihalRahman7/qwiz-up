<?xml version="1.0" encoding="utf-8"?><!-- Écran Question : une question à la fois, puis l'écran de résultat -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".presentation.question.QuestionFragment">

    <!-- ===== Partie jeu ===== -->
    <LinearLayout
        android:id="@+id/groupe_jeu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- En-tête : quitter + titre + compteur + progression -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_quitter"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/question_quitter"
                app:icon="@drawable/ic_fermer"
                app:iconTint="@color/text_primary"
                app:strokeColor="@color/border" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_titre_quiz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Le système solaire" />

                    <TextView
                        android:id="@+id/text_compteur"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:text="1 / 5" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progression"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:indicatorColor="@color/primary_green"
                    app:trackColor="@color/border"
                    app:trackCornerRadius="3dp"
                    app:trackStopIndicatorSize="0dp"
                    app:trackThickness="6dp"
                    tools:progress="20" />
            </LinearLayout>
        </LinearLayout>

        <!-- Question et réponses : défilent si l'écran est petit -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <TextView
                    android:id="@+id/text_numero_question"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:letterSpacing="0.05"
                    android:textAllCaps="true"
                    android:textColor="@color/primary_green"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Question 1" />

                <TextView
                    android:id="@+id/text_enonce"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="Quelle planète est la plus proche du Soleil ?" />

                <!-- 4 réponses (2 seulement pour un vrai ou faux) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_reponse_a"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="24dp"
                    android:gravity="start|center_vertical"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    app:backgroundTint="@color/surface"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="2dp"
                    tools:text="A · Vénus" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_reponse_b"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="10dp"
                    android:gravity="start|center_vertical"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    app:backgroundTint="@color/surface"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="2dp"
                    tools:text="B · Mercure" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_reponse_c"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="10dp"
                    android:gravity="start|center_vertical"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    app:backgroundTint="@color/surface"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="2dp"
                    tools:text="C · Mars" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_reponse_d"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="10dp"
                    android:gravity="start|center_vertical"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    app:backgroundTint="@color/surface"
                    app:cornerRadius="16dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="2dp"
                    tools:text="D · Terre" />

                <!-- Message bonne / mauvaise réponse -->
                <TextView
                    android:id="@+id/text_retroaction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:padding="14dp"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:background="@color/light_green"
                    tools:text="Bonne réponse !"
                    tools:textColor="@color/primary_green"
                    tools:visibility="visible" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_suivant"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="@string/question_choisir"
            android:textColor="@color/texte_bouton_principal"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/fond_bouton_principal"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <!-- ===== Partie résultat (cachée pendant le jeu) ===== -->
    <LinearLayout
        android:id="@+id/groupe_resultat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="140dp"
            android:layout_height="140dp"
            app:cardBackgroundColor="@color/light_green"
            app:cardCornerRadius="70dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/text_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/primary_green"
                android:textSize="40sp"
                android:textStyle="bold"
                tools:text="4 / 5" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/text_resultat_titre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="Excellent travail !" />

        <TextView
            android:id="@+id/text_resultat_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            tools:text="Tu as terminé « Le système solaire »." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_rejouer"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:text="@string/resultat_rejouer"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_retour_accueil"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="@string/resultat_retour"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="16dp"
            app:strokeColor="@color/border" />
    </LinearLayout>

</FrameLayout>