<?xml version="1.0" encoding="utf-8"?><!-- Écran Question : une question à la fois, puis l'écran de résultat -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    tools:context=".presentation.question.FragmentQuestion">

    <!-- ===== Partie jeu ===== -->
    <LinearLayout
        android:id="@+id/groupe_jeu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <!-- En-tête : quitter, titre du quiz, compteur -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_quitter"
                style="@style/Widget.Material3.Button.IconButton.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/question_quitter"
                app:backgroundTint="@color/white"
                app:icon="@drawable/ic_fermer"
                app:iconTint="@color/encre"
                app:strokeColor="@color/bordure" />

            <TextView
                android:id="@+id/text_titre_quiz"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/figtree_extrabold"
                android:maxLines="1"
                android:textColor="@color/encre"
                android:textSize="15sp"
                tools:text="La Révolution tranquille" />

            <TextView
                android:id="@+id/text_compteur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pastille"
                android:backgroundTint="@color/primaire_clair"
                android:fontFamily="@font/figtree_extrabold"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:textColor="@color/primaire_fonce"
                android:textSize="14sp"
                tools:text="2 / 4" />
        </LinearLayout>

        <!-- Progression : barre corail épaisse -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:indicatorColor="@color/corail"
            app:trackColor="@color/bordure"
            app:trackCornerRadius="5dp"
            app:trackStopIndicatorSize="0dp"
            app:trackThickness="10dp"
            tools:progress="50" />

        <!-- Question et réponses : défilent si l'écran est petit -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- Carte violette de la question, avec un rond décoratif -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/primaire"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="-36dp"
                            android:layout_marginBottom="-46dp"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/primaire_moyen" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="20dp"
                            android:paddingTop="22dp"
                            android:paddingEnd="20dp"
                            android:paddingBottom="22dp">

                            <TextView
                                android:id="@+id/text_numero_question"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/figtree_extrabold"
                                android:letterSpacing="0.05"
                                android:textAllCaps="true"
                                android:textColor="@color/primaire_clair"
                                android:textSize="13sp"
                                tools:text="Question 2" />

                            <TextView
                                android:id="@+id/text_enonce"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:fontFamily="@font/figtree_extrabold"
                                android:lineSpacingExtra="3sp"
                                android:textColor="@color/white"
                                android:textSize="22sp"
                                tools:text="Qui est devenu premier ministre du Québec en 1960 ?" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4 réponses (2 seulement pour un vrai ou faux) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_reponse_a"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="start|center_vertical"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="64dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/encre"
                    android:textSize="17sp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/bordure"
                    app:strokeWidth="2dp"
                    tools:text="A · Jean Lesage" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_reponse_b"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="start|center_vertical"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="64dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/encre"
                    android:textSize="17sp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/bordure"
                    app:strokeWidth="2dp"
                    tools:text="B · Maurice Duplessis" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_reponse_c"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="start|center_vertical"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="64dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/encre"
                    android:textSize="17sp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/bordure"
                    app:strokeWidth="2dp"
                    tools:text="C · René Lévesque" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_reponse_d"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/figtree_bold"
                    android:gravity="start|center_vertical"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="64dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/encre"
                    android:textSize="17sp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="18dp"
                    app:strokeColor="@color/bordure"
                    app:strokeWidth="2dp"
                    tools:text="D · Paul Sauvé" />

                <!-- Message bonne / mauvaise réponse : bulle arrondie (couleur choisie par le Fragment) -->
                <TextView
                    android:id="@+id/text_retroaction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_carre"
                    android:fontFamily="@font/figtree_bold"
                    android:lineSpacingExtra="2sp"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp"
                    android:textSize="14sp"
                    android:visibility="gone"
                    tools:backgroundTint="@color/corail_clair"
                    tools:text="Pas tout à fait. La bonne réponse est « Jean Lesage »."
                    tools:textColor="@color/corail_texte"
                    tools:visibility="visible" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_suivant"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:fontFamily="@font/figtree_extrabold"
            android:text="@string/question_choisir"
            android:textColor="@color/texte_bouton_principal"
            android:textSize="16sp"
            app:backgroundTint="@color/fond_bouton_principal"
            app:cornerRadius="16dp" />
    </LinearLayout>

    <!-- ===== Partie résultat (cachée pendant le jeu) ===== -->
    <LinearLayout
        android:id="@+id/groupe_resultat"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="22dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Carré jaune penché avec le trophée -->
            <FrameLayout
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@drawable/bg_carre"
                android:backgroundTint="@color/soleil"
                android:rotation="6">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_trophee" />
            </FrameLayout>

            <TextView
                android:id="@+id/text_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="@font/figtree_extrabold"
                android:textColor="@color/encre"
                android:textSize="56sp"
                tools:text="3 / 4" />

            <TextView
                android:id="@+id/text_resultat_titre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/figtree_extrabold"
                android:textColor="@color/encre"
                android:textSize="24sp"
                tools:text="Bien joué !" />

            <TextView
                android:id="@+id/text_resultat_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textColor="@color/encre_secondaire"
                android:textSize="15sp"
                tools:text="Tu as terminé « La Révolution tranquille »." />

            <!-- Tuiles : réussite et erreurs (calculées avec le score) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/primaire_clair"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_target" />

                        <TextView
                            android:id="@+id/text_reussite_resultat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/figtree_extrabold"
                            android:textColor="@color/encre"
                            android:textSize="22sp"
                            tools:text="75 %" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/figtree_bold"
                            android:text="@string/resultat_reussite"
                            android:textColor="@color/primaire_fonce"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/corail_clair"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_fermer"
                            app:tint="@color/corail_texte" />

                        <TextView
                            android:id="@+id/text_erreurs_resultat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/figtree_extrabold"
                            android:textColor="@color/encre"
                            android:textSize="22sp"
                            tools:text="1" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/figtree_bold"
                            android:text="@string/resultat_erreurs"
                            android:textColor="@color/corail_texte"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>

        <!-- Boutons en bas -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_rejouer"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:fontFamily="@font/figtree_extrabold"
            android:text="@string/resultat_rejouer"
            android:textSize="16sp"
            app:backgroundTint="@color/primaire"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_retour_accueil"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/figtree_bold"
            android:text="@string/resultat_retour"
            android:textColor="@color/encre"
            android:textSize="16sp"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            app:strokeColor="@color/bordure" />
    </LinearLayout>

</FrameLayout>