<?xml version="1.0" encoding="utf-8"?><!-- Écran Bienvenue : logo en haut, puis Créer un compte / J'ai déjà un compte -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primaire"
    android:orientation="vertical"
    tools:context=".presentation.onboarding.FragmentBienvenue">

    <!-- Haut violet : logo et nom de l'app -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@string/logo_description"
            android:src="@drawable/logo_qwizup" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/figtree_extrabold"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="36sp" />
    </LinearLayout>

    <!-- Bas blanc : titre, texte et les deux boutons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_feuille"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_extrabold"
            android:text="@string/bienvenue_titre"
            android:textColor="@color/encre"
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/bienvenue_texte"
            android:textColor="@color/encre_secondaire"
            android:textSize="15sp" />

        <!-- Bouton principal : Créer un compte -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_creer_compte"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/bienvenue_creer_compte"
            android:textSize="16sp"
            app:backgroundTint="@color/primaire"
            app:cornerRadius="16dp" />

        <!-- Bouton à contour : J'ai déjà un compte -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_deja_compte"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/bienvenue_deja_compte"
            android:textColor="@color/primaire"
            android:textSize="16sp"
            app:cornerRadius="16dp"
            app:strokeColor="@color/bordure" />
    </LinearLayout>

</LinearLayout>