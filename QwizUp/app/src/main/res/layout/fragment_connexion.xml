<?xml version="1.0" encoding="utf-8"?><!-- Écran Connexion : logo, nom d'utilisateur, mot de passe, puis Me connecter en bas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp"
    tools:context=".presentation.onboarding.FragmentConnexion">

    <!-- En-tête : logo et « QwizUp » (Up en violet) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/logo_description"
            android:src="@drawable/logo_qwizup" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/figtree_extrabold"
            android:text="@string/nom_qwiz"
            android:textColor="@color/encre"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_extrabold"
            android:text="@string/nom_up"
            android:textColor="@color/primaire"
            android:textSize="22sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/figtree_extrabold"
        android:text="@string/connexion_titre"
        android:textColor="@color/encre"
        android:textSize="28sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/connexion_sous_titre"
        android:textColor="@color/encre_secondaire"
        android:textSize="15sp" />

    <!-- Nom d'utilisateur -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/figtree_extrabold"
        android:text="@string/connexion_label_nom"
        android:textColor="@color/encre"
        android:textSize="14sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/champ_nom"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:boxBackgroundColor="@color/white"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxStrokeColor="@color/primaire"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_personne"
        app:startIconTint="@color/encre_secondaire">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_nom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:textColor="@color/encre"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Mot de passe : l'œil à droite affiche ou cache le texte -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/figtree_extrabold"
        android:text="@string/connexion_label_mot_de_passe"
        android:textColor="@color/encre"
        android:textSize="14sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/champ_mot_de_passe"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:boxBackgroundColor="@color/white"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxStrokeColor="@color/primaire"
        app:endIconMode="password_toggle"
        app:endIconTint="@color/encre_secondaire"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_cadenas"
        app:startIconTint="@color/encre_secondaire">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_mot_de_passe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:textColor="@color/encre"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Mot de passe oublié (TODO : à brancher par l'équipe des comptes) -->
    <TextView
        android:id="@+id/text_mot_de_passe_oublie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:fontFamily="@font/figtree_bold"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:text="@string/connexion_mot_de_passe_oublie"
        android:textColor="@color/primaire"
        android:textSize="14sp" />

    <!-- Espace vide : pousse le bouton tout en bas de l'écran -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bouton Me connecter : actif seulement quand les deux champs sont remplis -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_connexion"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:enabled="false"
        android:fontFamily="@font/figtree_extrabold"
        android:text="@string/connexion_bouton"
        android:textColor="@color/texte_bouton_principal"
        android:textSize="16sp"
        app:backgroundTint="@color/fond_bouton_principal"
        app:cornerRadius="16dp" />

    <!-- Pas encore de compte? Créer un compte -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_semibold"
            android:text="@string/connexion_pas_de_compte"
            android:textColor="@color/encre_secondaire"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_creer_compte"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_extrabold"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/connexion_creer_compte"
            android:textColor="@color/primaire"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>