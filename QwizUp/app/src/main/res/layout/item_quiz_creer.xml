<?xml version="1.0" encoding="utf-8"?><!-- Une ligne de la liste de Créer : titre, nombre de questions et bouton Continuer / Modifier -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_titre_quiz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/encre"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Le système solaire" />

        <TextView
            android:id="@+id/text_details_quiz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/encre_secondaire"
            android:textSize="13sp"
            tools:text="5 questions" />
    </LinearLayout>

    <!-- Bouton arrondi « Continuer » ou « Modifier » -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_continuer"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/encre"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="20dp"
        app:strokeColor="@color/bordure"
        tools:text="@string/creer_continuer" />
</LinearLayout>