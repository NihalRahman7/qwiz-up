<?xml version="1.0" encoding="utf-8"?><!-- Écran Détail du quiz : couverture, infos, meilleur score et bouton Jouer en bas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond"
    android:orientation="vertical"
    tools:context=".presentation.discover.FragmentDétailQuiz">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Couverture : couleur et grande icône de la catégorie (choisies par le Fragment) -->
            <FrameLayout
                android:id="@+id/couverture"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:background="@color/categorie_autre">

                <ImageView
                    android:id="@+id/icone"
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="-10dp"
                    android:alpha="0.25"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_couverture_autre"
                    app:tint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_retour"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:contentDescription="@string/detail_retour"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_retour"
                    app:iconTint="@color/encre" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_favori"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@string/discover_add_favorite"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_star_outline"
                    app:iconTint="@null" />
            </FrameLayout>

            <!-- Feuille du contenu : remonte un peu sur la couverture, coins du haut arrondis -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-26dp"
                android:background="@drawable/bg_feuille"
                android:backgroundTint="@color/fond"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="22dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <TextView
                    android:id="@+id/text_categorie"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/figtree_extrabold"
                    android:letterSpacing="0.05"
                    android:textAllCaps="true"
                    android:textSize="13sp"
                    tools:text="Histoire" />

                <TextView
                    android:id="@+id/text_titre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/figtree_extrabold"
                    android:textColor="@color/encre"
                    android:textSize="26sp"
                    tools:text="La Révolution tranquille" />

                <!-- Étiquettes : nombre de questions et durée -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/text_nb_questions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_etiquette"
                        android:fontFamily="@font/figtree_bold"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/encre"
                        android:textSize="13sp"
                        tools:text="4 questions" />

                    <TextView
                        android:id="@+id/text_duree"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_etiquette"
                        android:fontFamily="@font/figtree_bold"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:textColor="@color/encre"
                        android:textSize="13sp"
                        tools:text="3 min" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="3sp"
                    android:textColor="@color/encre_secondaire"
                    android:textSize="15sp"
                    tools:text="Les grands changements du Québec dans les années 1960 : éducation, État et société." />

                <!-- Meilleur score : visible seulement si le quiz a déjà été joué -->
                <LinearLayout
                    android:id="@+id/bandeau_meilleur_score"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_carre"
                    android:backgroundTint="@color/soleil_clair"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_star_filled" />

                    <TextView
                        android:id="@+id/text_meilleur_score"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="@font/figtree_bold"
                        android:textColor="@color/soleil_texte"
                        android:textSize="14sp"
                        tools:text="Ton meilleur score : 3 / 4" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bas de l'écran : ligne fine et bouton Jouer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bordure" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_jouer"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/figtree_extrabold"
        android:text="@string/detail_jouer"
        android:textSize="16sp"
        app:backgroundTint="@color/primaire"
        app:cornerRadius="16dp"
        app:icon="@drawable/ic_play"
        app:iconGravity="textEnd"
        app:iconSize="16dp"
        app:iconTint="@color/white" />

</LinearLayout>