<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.crosemont.qwizup.presentation.home.FragmentAccueil"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_accueil_vers_question"
            app:destination="@id/questionFragment" />
        <action
            android:id="@+id/action_accueil_vers_rejoindre"
            app:destination="@id/rejoindreFragment" />
        <action
            android:id="@+id/action_accueil_vers_profil"
            app:destination="@id/profilFragment" />
    </fragment>

    <fragment
        android:id="@+id/bienvenueFragment"
        android:name="com.crosemont.qwizup.presentation.onboarding.FragmentBienvenue"
        android:label="fragment_bienvenue"
        tools:layout="@layout/fragment_bienvenue">
        <action
            android:id="@+id/action_bienvenue_vers_accueil"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/bienvenueFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_bienvenue_vers_connexion"
            app:destination="@id/connexionFragment" />
        <action
            android:id="@+id/action_bienvenue_vers_inscription"
            app:destination="@id/inscriptionFragment" />
    </fragment>

    <fragment
        android:id="@+id/connexionFragment"
        android:name="com.crosemont.qwizup.presentation.onboarding.FragmentBienvenue"
        android:label="fragment_connexion"
        tools:layout="@layout/fragment_connexion">
        <action
            android:id="@+id/action_connexion_vers_accueil"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/bienvenueFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_connexion_vers_inscription"
            app:destination="@id/inscriptionFragment"
            app:popUpTo="@id/connexionFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/inscriptionFragment"
        android:name="com.crosemont.qwizup.presentation.onboarding.FragmentInscription"
        android:label="fragment_inscription"
        tools:layout="@layout/fragment_inscription">
        <action
            android:id="@+id/action_inscription_vers_accueil"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/bienvenueFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_inscription_vers_connexion"
            app:destination="@id/connexionFragment"
            app:popUpTo="@id/inscriptionFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/createFragment"
        android:name="com.crosemont.qwizup.presentation.create.FragmentCreate"
        android:label="fragment_create"
        tools:layout="@layout/fragment_create">
        <action
            android:id="@+id/action_creer_vers_editeur"
            app:destination="@id/editeurQuizFragment" />
    </fragment>

    <fragment
        android:id="@+id/editeurQuizFragment"
        android:name="com.crosemont.qwizup.presentation.create.ÉditeurQuizFragment"
        android:label="fragment_editeur_quiz"
        tools:layout="@layout/fragment_editeur_quiz">
        <argument
            android:name="quizId"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/discoverFragment"
        android:name="com.crosemont.qwizup.presentation.discover.VueDécouvrir"
        android:label="fragment_discover"
        tools:layout="@layout/fragment_discover">
        <action
            android:id="@+id/action_decouvrir_vers_question"
            app:destination="@id/questionFragment" />
        <action
            android:id="@+id/action_decouvrir_vers_detail"
            app:destination="@id/detailQuizFragment" />
    </fragment>

    <fragment
        android:id="@+id/libraryFragment"
        android:name="com.crosemont.qwizup.presentation.library.FragmentLibrairie"
        android:label="fragment_library"
        tools:layout="@layout/fragment_library" />

    <fragment
        android:id="@+id/questionFragment"
        android:name="com.crosemont.qwizup.presentation.question.FragmentQuestion"
        android:label="fragment_question"
        tools:layout="@layout/fragment_question">
        <argument
            android:name="quizId"
            android:defaultValue="1"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/rejoindreFragment"
        android:name="com.crosemont.qwizup.presentation.rejoindre.RejoindreFragment"
        android:label="fragment_rejoindre"
        tools:layout="@layout/fragment_rejoindre">
        <action
            android:id="@+id/action_rejoindre_vers_question"
            app:destination="@id/questionFragment"
            app:popUpTo="@id/rejoindreFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/profilFragment"
        android:name="com.crosemont.qwizup.presentation.profil.FragmentProfil"
        android:label="fragment_profil"
        tools:layout="@layout/fragment_profil">
        <action
            android:id="@+id/action_profil_vers_creer"
            app:destination="@id/createFragment" />
        <action
            android:id="@+id/action_profil_vers_bienvenue"
            app:destination="@id/bienvenueFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/detailQuizFragment"
        android:name="com.crosemont.qwizup.presentation.discover.FragmentDétailQuiz"
        android:label="fragment_detail_quiz"
        tools:layout="@layout/fragment_detail_quiz">
        <argument
            android:name="quizId"
            android:defaultValue="-1"
            app:argType="integer" />
        <action
            android:id="@+id/action_detail_vers_question"
            app:destination="@id/questionFragment" />
    </fragment>
</navigation>